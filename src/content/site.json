  "hobbies": [
    {
      "id": "photography",
      "title": "摄影",
      "summary": "用照片保存光线、城市和情绪。",
      "detail": "喜欢风景、城市和日常记录。比起追求器材参数，更在意照片有没有留下当时的感觉。",
      "image": "/images/photo-city.svg",
      "paragraphs": [
        "真的成功了嘛"
