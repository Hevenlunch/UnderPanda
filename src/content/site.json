  "about": {
    "kicker": "ABOUT ME / 关于我",
    "heading": "把生活过具体，也把自己慢慢讲清楚。",
    "lead": "你好，我是垫底熊猫。一个愿意认真做事，也不想把生活过得太严肃的人。",
    "paragraphs": [
      "我喜欢摄影，喜欢在城市和自然之间走走停停。拍照对我来说不是提醒，更像一种习惯：慢一点，多看一眼，把容易被忽略的瞬间留下来。",
      "我的生活里有很多不同的侧面。会认真做研究，也会研究一段音乐、一次远行和一张照片的后期；喜欢和人交流，也享受一个人安静放空大脑的时刻。"
    ],
    "traits": [
      {
        "title": "乐观",
        "text": "遇到问题先找办法，也相信事情会慢慢变好。"
      },
      {
        "title": "幽默",
        "text": "不把生活过得太严肃，偶尔也拿自己开开玩笑。"
      },
      {
        "title": "靠谱",
        "text": "答应的事情认真完成，不轻易画大饼。"
      }
    ],
    "current": {
      "label": "最近的我在做什么",
      "title": "继续研究，也继续拍照。",
      "text": "把专业上的问题做扎实，也慢慢整理走过的城市、遇见的人和那些值得记住的日常。"
    }
  },
