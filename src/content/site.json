      ]
    },
    {
      "id": "travel",
      "title": "旅行",
      "summary": "去没有去过的地方，也重新看看熟悉的地方。",
      "detail": "旅行对我最大的吸引力，不只是目的地，而是路上发生的意外、遇见的人和回来之后仍然记得的细节。",
      "image": "/images/photo-travel.svg"
    },
    {
      "id": "drone",
      "title": "无人机",
      "summary": "换一个高度，看熟悉世界的新样子。",
      "detail": "喜欢用航拍观察城市、山川和海岸的线条。它让我意识到，同一片风景换个高度看会完全不同。",
      "image": "/images/photo-cloud.svg"
    },
    {
      "id": "editing",
      "title": "图片后期",
      "summary": "把拍摄当下的感受重新还回来。",
      "detail": "后期不是把照片改得不像原来的样子，而是调整颜色、光线和氛围，让记忆更接近当时的感觉。",
      "image": "/images/photo-detail.svg"
    },
    {
      "id": "music",
      "title": "音乐",
      "summary": "给通勤、夜晚和整理照片加一点背景。",
      "detail": "喜欢的风格比较杂，开心时听节奏，安静时听旋律。很多照片的记忆里都有一首对应的歌。",
      "image": "/images/photo-night.svg"
    },
    {
      "id": "dance",
      "title": "街舞",
      "summary": "身体动起来的时候，生活也会轻一点。",
      "detail": "曾经参与过校园街舞社团和演出。它让我在表达、节奏和团队配合里找到另一种快乐。",
      "image": "/images/photo-street.svg"
    }
